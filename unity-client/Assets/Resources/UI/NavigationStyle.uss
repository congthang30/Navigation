/* ==========================================================================
   VPS AR INDOOR NAVIGATION - MODERN UI TOOLKIT DESIGN SYSTEM
   Target Logical Viewport: 390x844dp (ScaleWithScreenSize)
   Typography: Inter-Regular SDF / Inter-SemiBold SDF (Vietnamese Full Support)
   ========================================================================== */

:root {
    -unity-font-definition: resource("UI/Fonts/Inter-Regular SDF");
    color: #0F172A;
}

.screen-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
}

/* ---------- Vector Icon Primitives ---------- */
.vec-icon {
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.vec-icon--12 { width: 12px; height: 12px; }
.vec-icon--14 { width: 14px; height: 14px; }
.vec-icon--16 { width: 16px; height: 16px; }
.vec-icon--18 { width: 18px; height: 18px; }
.vec-icon--20 { width: 20px; height: 20px; }
.vec-icon--22 { width: 22px; height: 22px; }
.vec-icon--24 { width: 24px; height: 24px; }
.vec-icon--26 { width: 26px; height: 26px; }

.vec-icon--white { -unity-background-image-tint-color: #FFFFFF; }
.vec-icon--cyan { -unity-background-image-tint-color: #22D3EE; }
.vec-icon--brand { -unity-background-image-tint-color: #0284C7; }
.vec-icon--amber { -unity-background-image-tint-color: #FBBF24; }
.vec-icon--amber-ink { -unity-background-image-tint-color: #D97706; }
.vec-icon--emerald { -unity-background-image-tint-color: #059669; }
.vec-icon--indigo { -unity-background-image-tint-color: #4F46E5; }
.vec-icon--danger { -unity-background-image-tint-color: #E11D48; }
.vec-icon--slate { -unity-background-image-tint-color: #334155; }
.vec-icon--muted { -unity-background-image-tint-color: #94A3B8; }

/* ---------- Launcher Light Atmospheric Backdrop ---------- */
.launcher-bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #F4F7FB;
    overflow: hidden;
}

.launcher-glow {
    position: absolute;
}

.launcher-glow--cyan {
    width: 340px;
    height: 340px;
    border-radius: 170px;
    top: -110px;
    right: -110px;
    background-color: rgba(14, 165, 233, 0.10);
}

.launcher-glow--indigo {
    width: 380px;
    height: 380px;
    border-radius: 190px;
    bottom: -140px;
    left: -130px;
    background-color: rgba(99, 102, 241, 0.08);
}

.launcher-glow--emerald {
    width: 280px;
    height: 280px;
    border-radius: 140px;
    top: 32%;
    right: -150px;
    background-color: rgba(16, 185, 129, 0.05);
}

/* ---------- AR Scan Viewfinder Reticle ---------- */
.scan-reticle-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.scan-reticle-box {
    width: 204px;
    height: 204px;
    position: relative;
    justify-content: center;
    align-items: center;
}

.reticle-corner {
    position: absolute;
    width: 28px;
    height: 28px;
    border-color: rgba(56, 189, 248, 0.85);
}

.reticle-corner--tl {
    left: 0;
    top: 0;
    border-left-width: 3px;
    border-top-width: 3px;
    border-top-left-radius: 10px;
}

.reticle-corner--tr {
    right: 0;
    top: 0;
    border-right-width: 3px;
    border-top-width: 3px;
    border-top-right-radius: 10px;
}

.reticle-corner--bl {
    left: 0;
    bottom: 0;
    border-left-width: 3px;
    border-bottom-width: 3px;
    border-bottom-left-radius: 10px;
}

.reticle-corner--br {
    right: 0;
    bottom: 0;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-bottom-right-radius: 10px;
}

.reticle-center-cross {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgba(56, 189, 248, 0.65);
}

.scan-hint-text {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 12px;
    color: #FFFFFF;
    text-shadow: 0px 1px 4px rgba(15, 23, 42, 0.85);
    -unity-text-align: middle-center;
    white-space: normal;
    align-self: center;
    max-width: 290px;
    margin: 18px 20px 0 20px;
    padding: 0;
}

/* ---------- Main Safe Area Layout ---------- */
.safe-area-container {
    flex-grow: 1;
    flex-direction: column;
    justify-content: space-between;
    padding: 14px 16px 20px 16px;
}

.header-area {
    flex-direction: column;
    width: 100%;
    max-width: 520px;
    align-self: center;
}

.hud-center-area {
    margin-top: 16px;
    width: 100%;
}

.bottom-area {
    flex-direction: column;
    width: 100%;
    max-width: 520px;
    align-self: center;
}

/* ---------- Header Bars ---------- */
.header-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.header-bar--idle {
    padding: 4px 2px;
}

.brand-cluster {
    flex-direction: row;
    align-items: center;
}

.brand-emblem {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background-color: transparent;
    border-width: 0;
    justify-content: center;
    align-items: center;
    margin-right: 10px;
    padding: 0;
    overflow: hidden;
    flex-shrink: 0;
}

.brand-logo-img {
    width: 40px;
    height: 40px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.brand-text-col {
    flex-direction: column;
}

.brand-title {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 16px;
    color: #0F172A;
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

.brand-subtitle {
    font-size: 11px;
    color: #64748B;
    margin: 1px 0 0 0;
    padding: 0;
}

.header-bar--glass {
    background-color: rgba(255, 255, 255, 0.94);
    border-width: 1px;
    border-color: #E2E8F0;
    border-top-color: #FFFFFF;
    border-radius: 20px;
    padding: 10px 12px;
}

.header-bar--nav-glass {
    flex-direction: column;
    align-items: stretch;
    background-color: rgba(255, 255, 255, 0.94);
    border-width: 1px;
    border-color: #E2E8F0;
    border-top-color: #FFFFFF;
    border-radius: 20px;
    padding: 10px 12px 9px 12px;
}

.nav-header-top-row {
    flex-direction: row;
    align-items: center;
}

.nav-pin-badge {
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background-color: #E0F2FE;
    border-width: 1px;
    border-color: #BAE6FD;
    justify-content: center;
    align-items: center;
    margin-right: 10px;
    flex-shrink: 0;
}

.nav-pin-badge--arrived {
    background-color: #D1FAE5;
    border-color: #A7F3D0;
}

.header-center-col {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    margin: 0 8px 0 2px;
}

.status-inline-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.eyebrow-tag {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 10px;
    letter-spacing: 0.6px;
    margin: 0;
    padding: 0;
}

.eyebrow-tag--cyan { color: #0284C7; }
.eyebrow-tag--amber { color: #D97706; }
.eyebrow-tag--emerald { color: #059669; }

.header-glass-title {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 14px;
    color: #0F172A;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
    padding: 0;
}

.nav-header-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.distance-pill {
    background-color: #E0F2FE;
    border-width: 1px;
    border-color: #BAE6FD;
    border-radius: 13px;
    padding: 5px 10px;
    margin-right: 6px;
    justify-content: center;
}

.distance-pill--arrived {
    background-color: #D1FAE5;
    border-color: #A7F3D0;
}

.distance-pill-text {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 12px;
    color: #0369A1;
    margin: 0;
    padding: 0;
}

.distance-pill-text--arrived {
    color: #047857;
}

.nav-progress-track {
    height: 4px;
    width: 100%;
    border-radius: 2px;
    background-color: #E2E8F0;
    margin-top: 9px;
    overflow: hidden;
}

.nav-progress-fill {
    height: 100%;
    width: 6%;
    border-radius: 2px;
    background-color: #0EA5E9;
}

.nav-progress-fill--arrived {
    background-color: #10B981;
}

/* ---------- Dots ---------- */
.dot-indicator {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    margin-right: 6px;
    flex-shrink: 0;
}

.dot-indicator--amber { background-color: #D97706; }
.dot-indicator--emerald { background-color: #059669; }
.dot-indicator--cyan { background-color: #0284C7; }
.dot-indicator--danger { background-color: #E11D48; }

/* ---------- Buttons ---------- */
.btn-icon {
    width: 40px;
    height: 40px;
    border-radius: 13px;
    justify-content: center;
    align-items: center;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.btn-icon:active {
    scale: 0.94;
}

.btn-icon--light-glass {
    background-color: #FFFFFF;
    border-width: 1px;
    border-color: #E2E8F0;
}

.btn-icon--light-glass:hover {
    background-color: #F1F5F9;
}

.btn-icon--light-subtle {
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background-color: #F1F5F9;
    border-width: 1px;
    border-color: #E2E8F0;
}

.btn-icon--light-subtle:hover {
    background-color: #E2E8F0;
}

.btn-icon--light-close {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: #E2E8F0;
    border-width: 0;
}

.btn-icon--light-close:hover {
    background-color: #CBD5E1;
}

.btn-pill {
    border-radius: 14px;
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    justify-content: center;
    align-items: center;
    flex-direction: row;
    border-width: 0;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.btn-pill:active {
    scale: 0.97;
}

.btn-compact {
    height: 34px;
    padding: 0 12px;
    font-size: 12px;
    border-radius: 11px;
}

.btn-large {
    height: 48px;
    border-radius: 16px;
    font-size: 15px;
    width: 100%;
}

.btn-primary {
    background-color: #0EA5E9;
    border-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.35);
    border-left-color: #0EA5E9;
    border-right-color: #0EA5E9;
    border-bottom-color: #0284C7;
    color: #FFFFFF;
}

.btn-primary:hover {
    background-color: #0284C7;
}

.btn-primary:disabled {
    background-color: #CBD5E1;
    border-color: #CBD5E1;
    color: #64748B;
}

.btn-primary-label {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 15px;
    color: #FFFFFF;
    margin: 0 0 0 8px;
    padding: 0;
}

.btn-secondary-light {
    background-color: #E2E8F0;
    color: #1E293B;
    height: 44px;
    border-radius: 14px;
    font-size: 14px;
}

.btn-secondary-light:hover {
    background-color: #CBD5E1;
}

.btn-soft-cyan {
    background-color: #E0F2FE;
    color: #0369A1;
}

.btn-soft-cyan:hover {
    background-color: #BAE6FD;
}

.btn-danger-glass {
    background-color: #FFF1F2;
    border-width: 1px;
    border-color: #FECDD3;
    color: #BE123C;
    margin-left: 6px;
}

.btn-danger-glass:hover {
    background-color: #FFE4E6;
}

.btn-ghost-glass {
    background-color: #F1F5F9;
    border-width: 1px;
    border-color: #E2E8F0;
    color: #334155;
    margin-left: 8px;
}

.btn-ghost-glass:hover {
    background-color: #E2E8F0;
}

.btn-emerald-solid {
    background-color: #10B981;
    border-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.35);
    border-left-color: #10B981;
    border-right-color: #10B981;
    border-bottom-color: #059669;
    color: #FFFFFF;
    margin-left: 8px;
}

.btn-emerald-solid:hover {
    background-color: #059669;
}

.btn-finish-label {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 12px;
    color: #FFFFFF;
    margin: 0 0 0 6px;
    padding: 0;
}

/* ---------- Hero Readiness Card (Idle) ---------- */
.hero-readiness-card {
    background-color: #FFFFFF;
    border-width: 1px;
    border-color: #E2E8F0;
    border-radius: 22px;
    padding: 18px;
}

.hero-headline {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 20px;
    color: #0F172A;
    margin: 0 0 6px 0;
    padding: 0;
}

.hero-description {
    font-size: 13px;
    color: #475569;
    white-space: normal;
    margin: 0 0 14px 0;
    padding: 0;
}

.hero-error-banner {
    flex-direction: row;
    align-items: center;
    background-color: #FFF1F2;
    border-width: 1px;
    border-color: #FECDD3;
    border-radius: 12px;
    padding: 8px 10px;
    margin-bottom: 12px;
}

.hero-error-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12px;
    color: #BE123C;
    white-space: normal;
    margin: 0 8px;
    padding: 0;
}

.btn-retry-chip {
    flex-direction: row;
    align-items: center;
    background-color: #E11D48;
    border-width: 1px;
    border-color: #BE123C;
    border-radius: 10px;
    padding: 6px 10px;
    flex-shrink: 0;
}

.btn-retry-chip:hover {
    background-color: #BE123C;
}

.btn-retry-label {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 11px;
    color: #FFFFFF;
    margin: 0 0 0 5px;
    padding: 0;
}

.hero-steps-strip {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: #F8FAFC;
    border-width: 1px;
    border-color: #E2E8F0;
    border-radius: 12px;
    padding: 9px 10px;
}

.hero-step-pill {
    flex-direction: row;
    align-items: center;
}

.hero-step-label {
    font-size: 11px;
    color: #334155;
    margin: 0 0 0 5px;
    padding: 0;
}

.hero-step-divider {
    width: 1px;
    height: 14px;
    background-color: #CBD5E1;
}

/* ---------- Bottom Docks ---------- */
.bottom-dock {
    width: 100%;
}

.bottom-dock--idle {
    flex-direction: column;
}

.quick-picks-section {
    flex-direction: column;
    margin-bottom: 12px;
}

.quick-picks-eyebrow {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 10px;
    letter-spacing: 0.7px;
    color: #64748B;
    margin: 0 0 8px 4px;
    padding: 0;
}

.quick-picks-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.quick-pick-chip {
    flex-direction: row;
    align-items: center;
    background-color: #FFFFFF;
    border-width: 1px;
    border-color: #E2E8F0;
    border-radius: 14px;
    padding: 8px 11px;
    margin: 0 8px 8px 0;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.12s;
}

.quick-pick-chip:hover {
    background-color: #F0F9FF;
    border-color: #7DD3FC;
}

.quick-pick-chip:active {
    scale: 0.96;
}

.quick-pick-label {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 12px;
    color: #1E293B;
    margin: 0 0 0 6px;
    padding: 0;
    max-width: 132px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.launcher-cta-card {
    background-color: #FFFFFF;
    border-width: 1px;
    border-color: #E2E8F0;
    border-radius: 22px;
    padding: 8px;
}

.btn-launcher-search {
    flex-direction: row;
    align-items: center;
    background-color: #0EA5E9;
    border-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.42);
    border-left-color: #0EA5E9;
    border-right-color: #0EA5E9;
    border-bottom-color: #0284C7;
    border-radius: 16px;
    padding: 11px 14px;
    margin: 0;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.btn-launcher-search:hover {
    background-color: #0284C7;
}

.btn-launcher-search:active {
    scale: 0.98;
}

.launcher-search-icon-box {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.20);
    justify-content: center;
    align-items: center;
    margin-right: 12px;
    flex-shrink: 0;
}

.launcher-cta-text-col {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    align-items: flex-start;
}

.launcher-cta-title {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 15px;
    color: #FFFFFF;
    margin: 0;
    padding: 0;
}

.launcher-cta-subtitle {
    font-size: 11px;
    color: rgba(240, 249, 255, 0.88);
    margin: 2px 0 0 0;
    padding: 0;
}

.launcher-cta-trailing {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 8px;
}

.launcher-count-badge {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 11px;
    color: #FFFFFF;
    background-color: rgba(255, 255, 255, 0.22);
    border-radius: 10px;
    padding: 3px 8px;
    margin-right: 6px;
}

/* ---------- AR Light Glass Bottom Docks ---------- */
.bottom-dock--ar-glass {
    background-color: rgba(255, 255, 255, 0.94);
    border-width: 1px;
    border-color: #E2E8F0;
    border-top-color: #FFFFFF;
    border-radius: 22px;
    padding: 13px 14px;
}

.ar-dock-row {
    flex-direction: row;
    align-items: center;
}

.ar-dock-icon-badge {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    justify-content: center;
    align-items: center;
    margin-right: 12px;
    flex-shrink: 0;
}

.ar-dock-icon-badge--amber {
    background-color: #FEF3C7;
    border-width: 1px;
    border-color: #FDE68A;
}

.ar-dock-text-col {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    margin-right: 6px;
}

.ar-dock-title {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 14px;
    color: #0F172A;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.ar-dock-subtitle {
    font-size: 12px;
    color: #64748B;
    white-space: normal;
    margin: 2px 0 0 0;
    padding: 0;
}

.ar-dock-message {
    font-size: 13px;
    color: #1E293B;
    white-space: normal;
    margin: 3px 0 0 0;
    padding: 0;
}

.companion-avatar-box {
    width: 46px;
    height: 46px;
    border-radius: 15px;
    justify-content: center;
    align-items: center;
    margin-right: 12px;
    flex-shrink: 0;
    border-width: 1.5px;
}

.companion-avatar-box--walking {
    background-color: #E0F2FE;
    border-color: #7DD3FC;
}

.companion-avatar-box--waiting {
    background-color: #FEF3C7;
    border-color: #FCD34D;
}

.companion-avatar-box--reroute {
    background-color: #FFE4E6;
    border-color: #FDA4AF;
}

.companion-avatar-box--arrived {
    background-color: #D1FAE5;
    border-color: #6EE7B7;
}

.companion-state-badge {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 10px;
    letter-spacing: 0.6px;
    margin: 0;
    padding: 0;
}

.companion-state-badge--walking { color: #0284C7; }
.companion-state-badge--waiting { color: #D97706; }
.companion-state-badge--reroute { color: #E11D48; }
.companion-state-badge--arrived { color: #059669; }

/* ---------- Modal Bottom Sheets ---------- */
.modal-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(148, 163, 184, 0.36);
    justify-content: flex-end;
    align-items: center;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.18s;
}

.modal-overlay--hidden {
    opacity: 0;
    /* A hidden overlay must leave the picking path: it covers the whole screen, so while it stays
       pickable it silently swallows every touch and the whole UI becomes unresponsive. */
    visibility: hidden;
}

.bottom-sheet {
    width: 100%;
    max-width: 560px;
    max-height: 88%;
    background-color: #F8FAFC;
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #E2E8F0;
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
    flex-direction: column;
    overflow: hidden;
    translate: 0 0;
    transition-property: translate;
    transition-duration: 0.22s;
}

.modal-overlay--hidden .bottom-sheet {
    translate: 0 28px;
}

.bottom-sheet--settings {
    background-color: #F1F5F9;
    max-height: 90%;
}

.sheet-handle-wrap {
    width: 100%;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 4px;
}

.sheet-handle {
    width: 38px;
    height: 4px;
    border-radius: 2px;
    background-color: #CBD5E1;
}

.modal-header {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    padding: 8px 18px 12px 18px;
}

.modal-header--settings {
    background-color: #FFFFFF;
    border-bottom-width: 1px;
    border-bottom-color: #E2E8F0;
    padding-bottom: 14px;
}

.settings-header-lead {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 10px;
}

.settings-header-badge {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background-color: #E0F2FE;
    justify-content: center;
    align-items: center;
    margin-right: 12px;
    flex-shrink: 0;
}

.modal-title-group {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
}

.modal-title-row {
    flex-direction: row;
    align-items: center;
}

.modal-title {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 19px;
    color: #0F172A;
    margin: 0;
    padding: 0;
}

.modal-count-chip {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 11px;
    color: #0369A1;
    background-color: #E0F2FE;
    border-radius: 10px;
    padding: 2px 8px;
    margin-left: 8px;
}

.modal-subtitle {
    font-size: 12px;
    color: #64748B;
    white-space: normal;
    margin: 3px 0 0 0;
    padding: 0;
}

/* ---------- Search Bar & Category Chips ---------- */
.search-field-container {
    flex-direction: row;
    align-items: center;
    background-color: #FFFFFF;
    border-width: 1.5px;
    border-color: #E2E8F0;
    border-radius: 15px;
    height: 46px;
    padding: 0 10px 0 13px;
    margin: 0 18px 10px 18px;
    transition-property: border-color;
    transition-duration: 0.14s;
}

.search-field-container--focused {
    border-color: #0EA5E9;
}

.search-input {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 4px 0 8px;
    padding: 0;
}

.search-input .unity-base-text-field__input {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
    font-size: 14px;
    color: #0F172A;
}

.btn-clear-search {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background-color: #E2E8F0;
    border-width: 0;
    justify-content: center;
    align-items: center;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
}

.btn-clear-search:hover {
    background-color: #CBD5E1;
}

.filter-chips-scroll {
    max-height: 40px;
    margin: 0 18px 8px 18px;
    flex-shrink: 0;
}

.filter-chips-row {
    flex-direction: row;
    align-items: center;
    padding: 2px 0;
}

.filter-chip {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 12px;
    color: #475569;
    background-color: #FFFFFF;
    border-width: 1px;
    border-color: #E2E8F0;
    border-radius: 16px;
    height: 32px;
    padding: 0 13px;
    margin: 0 7px 0 0;
    justify-content: center;
    align-items: center;
}

.filter-chip:hover {
    background-color: #F1F5F9;
    border-color: #CBD5E1;
}

.filter-chip--active {
    background-color: #0EA5E9;
    border-color: #0EA5E9;
    color: #FFFFFF;
}

.filter-chip--active:hover {
    background-color: #0284C7;
    border-color: #0284C7;
}

/* ---------- POI Scroll List & Items ---------- */
.poi-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 180px;
    padding: 4px 18px 10px 18px;
}

.poi-items-container {
    flex-direction: column;
    padding-bottom: 6px;
}

.poi-item {
    flex-direction: row;
    align-items: center;
    background-color: #FFFFFF;
    border-width: 1.5px;
    border-color: #E2E8F0;
    border-radius: 16px;
    padding: 11px 12px;
    margin: 0 0 8px 0;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
}

.poi-item:hover {
    border-color: #BAE6FD;
    background-color: #FAFCFF;
}

.poi-item:active {
    scale: 0.985;
}

.poi-item--selected {
    background-color: #F0F9FF;
    border-color: #0EA5E9;
    border-width: 2px;
}

.poi-icon-box {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background-color: #F1F5F9;
    justify-content: center;
    align-items: center;
    margin-right: 12px;
    flex-shrink: 0;
}

.poi-icon-box--selected {
    background-color: #E0F2FE;
}

.poi-text-col {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    align-items: flex-start;
}

.poi-title {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 14px;
    color: #0F172A;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.poi-category {
    font-size: 12px;
    color: #64748B;
    margin: 2px 0 0 0;
    padding: 0;
}

.poi-radio {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    border-width: 2px;
    border-color: #CBD5E1;
    background-color: #FFFFFF;
    justify-content: center;
    align-items: center;
    margin-left: 10px;
    flex-shrink: 0;
}

.poi-radio--selected {
    border-color: #0EA5E9;
    background-color: #0EA5E9;
}

.poi-empty-container {
    align-items: center;
    justify-content: center;
    padding: 30px 18px;
}

.empty-icon-circle {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: #E2E8F0;
    justify-content: center;
    align-items: center;
    margin-bottom: 12px;
}

.empty-title {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 15px;
    color: #1E293B;
    margin: 0 0 4px 0;
    padding: 0;
}

.empty-subtitle {
    font-size: 12px;
    color: #64748B;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Modal Footers ---------- */
.modal-footer {
    background-color: #FFFFFF;
    border-top-width: 1px;
    border-top-color: #E2E8F0;
    padding: 12px 18px 20px 18px;
    flex-shrink: 0;
}

.modal-footer--picker {
    flex-direction: column;
}

.picker-selection-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.modal-selection-summary {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 13px;
    color: #334155;
    margin: 0 0 0 6px;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.modal-footer--settings {
    flex-direction: row;
    justify-content: space-between;
}

.modal-footer-btn-half {
    width: 48.5%;
    height: 46px;
}

/* ---------- Scrollbars (Sleek Minimal Modern Indicator) ---------- */
.unity-scroller--vertical {
    width: 6px;
    min-width: 6px;
    max-width: 6px;
    background-color: transparent;
    border-width: 0;
    margin: 4px 2px 4px 2px;
    padding: 0;
}

.unity-scroller--vertical .unity-scroller__low-button,
.unity-scroller--vertical .unity-scroller__high-button,
.unity-scroller--horizontal .unity-scroller__low-button,
.unity-scroller--horizontal .unity-scroller__high-button {
    display: none;
    width: 0;
    height: 0;
}

.unity-scroller--vertical .unity-scroller__slider {
    width: 6px;
    min-width: 6px;
    max-width: 6px;
    margin: 0;
    padding: 0;
    flex-grow: 1;
}

.unity-scroller--vertical .unity-base-slider__input {
    width: 6px;
    min-width: 6px;
    margin: 0;
    padding: 0;
}

.unity-scroller--vertical .unity-base-slider__drag-container {
    width: 6px;
    min-width: 6px;
    margin: 0;
    padding: 0;
}

.unity-scroller--vertical .unity-base-slider__tracker {
    width: 4px;
    min-width: 4px;
    left: 1px;
    top: 0;
    bottom: 0;
    background-color: transparent;
    border-width: 0;
    margin: 0;
}

.unity-scroller--vertical .unity-base-slider__dragger {
    width: 4px;
    min-width: 4px;
    max-width: 4px;
    left: 1px;
    right: auto;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 2px;
    background-color: rgba(148, 163, 184, 0.55);
}

.unity-scroller--vertical .unity-base-slider__dragger:hover,
.unity-scroller--vertical .unity-base-slider__dragger:active {
    background-color: rgba(100, 116, 139, 0.85);
}

.unity-scroller--vertical .unity-base-slider__dragger-border {
    display: none;
}

/* ---------- Settings Cards, Live Preview & Controls ---------- */
.settings-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 12px 10px 12px 16px;
}

.settings-scroll-view .unity-scroll-view__content-container,
.poi-scroll-view .unity-scroll-view__content-container {
    padding-right: 4px;
}

.settings-card {
    background-color: #FFFFFF;
    border-width: 1px;
    border-color: #E2E8F0;
    border-radius: 18px;
    padding: 14px;
    margin-bottom: 12px;
}

.settings-card--last {
    margin-bottom: 16px;
}

.settings-card-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.section-icon-chip {
    width: 28px;
    height: 28px;
    border-radius: 9px;
    justify-content: center;
    align-items: center;
    margin-right: 9px;
}

.section-icon-chip--cyan { background-color: #E0F2FE; }
.section-icon-chip--indigo { background-color: #E0E7FF; }
.section-icon-chip--emerald { background-color: #D1FAE5; }
.section-icon-chip--slate { background-color: #F1F5F9; }

.section-title {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 14px;
    color: #0F172A;
    margin: 0;
    padding: 0;
}

/* Live Route Preview Banner (Light Surface) */
.route-preview-box {
    background-color: #E2E8F0;
    border-width: 1px;
    border-color: #CBD5E1;
    border-radius: 14px;
    padding: 10px 14px 12px 14px;
    margin-bottom: 14px;
}

.route-preview-caption {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 9px;
    letter-spacing: 0.7px;
    color: #475569;
    margin: 0 0 10px 0;
    padding: 0;
}

.route-preview-stage {
    flex-direction: row;
    align-items: center;
    height: 20px;
}

.route-preview-node {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #FFFFFF;
    border-width: 2px;
    border-color: #64748B;
    flex-shrink: 0;
}

.route-preview-node--end {
    background-color: #0EA5E9;
    border-width: 1.5px;
    border-color: rgba(15, 23, 42, 0.16);
}

.route-preview-line {
    flex-grow: 1;
    height: 6px;
    border-radius: 3px;
    background-color: #00D1FA;
    border-width: 1px;
    border-color: rgba(15, 23, 42, 0.12);
    margin: 0 5px;
}

/* Circular Color-Only Swatches */
.color-swatch-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    padding: 2px 0;
}

.color-swatch-chip {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: transparent;
    border-width: 2px;
    border-color: transparent;
    justify-content: center;
    align-items: center;
    padding: 0;
    margin: 0;
    transition-property: scale, border-color, background-color;
    transition-duration: 0.12s;
}

.color-swatch-chip:active {
    scale: 0.92;
}

.color-swatch-chip--selected {
    background-color: rgba(14, 165, 233, 0.12);
    border-color: #0EA5E9;
}

.color-swatch-circle {
    width: 30px;
    height: 30px;
    border-radius: 15px;
    border-width: 1.5px;
    border-color: rgba(15, 23, 42, 0.18);
    justify-content: center;
    align-items: center;
    margin: 0;
}

/* Sliders (scoped so vertical scrollbars are never affected) */
.slider-group {
    margin-bottom: 12px;
}

.slider-group--last {
    margin-bottom: 0;
}

.slider-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3px;
}

.slider-label {
    font-size: 13px;
    color: #334155;
    margin: 0;
    padding: 0;
}

.slider-value {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 12px;
    color: #0284C7;
    background-color: #F0F9FF;
    border-radius: 8px;
    padding: 2px 7px;
    margin: 0;
    padding-top: 2px;
    padding-bottom: 2px;
}

.settings-range-slider {
    margin: 0;
    padding: 0;
}

.settings-range-slider .unity-base-slider__tracker {
    height: 6px;
    border-radius: 3px;
    background-color: #E2E8F0;
    border-width: 0;
}

.settings-range-slider .unity-base-slider__dragger {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: #FFFFFF;
    border-width: 3px;
    border-color: #0EA5E9;
    margin-top: -8px;
}

.settings-range-slider .unity-base-slider__dragger:hover {
    scale: 1.1;
}

/* Occlusion 2x2 Mode Grid */
.occlusion-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 8px;
}

/* Live occlusion diagnostics (graphics API, depth mode, fallback reason) */
.occlusion-status {
    color: #64748B;
    font-size: 11px;
    white-space: normal;
    margin-bottom: 8px;
}

.occlusion-card {
    width: 48.5%;
    background-color: #F8FAFC;
    border-width: 1.5px;
    border-color: #E2E8F0;
    border-radius: 13px;
    padding: 10px 10px;
    margin-bottom: 8px;
    flex-direction: column;
    align-items: flex-start;
}

.occlusion-card:hover {
    border-color: #BAE6FD;
}

.occlusion-card--selected {
    background-color: #F0F9FF;
    border-color: #0EA5E9;
}

.occlusion-card-top {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.occlusion-card-title {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 12px;
    color: #0F172A;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.occlusion-card-desc {
    font-size: 10px;
    color: #64748B;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.occlusion-badge-rec {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 9px;
    color: #047857;
    background-color: #D1FAE5;
    border-radius: 9px;
    padding: 1px 6px;
}

/* Modern Sliding Pill Switches (Unity Toggle - pixel-exact alignment) */
.toggle-group {
    flex-direction: column;
    margin-top: 2px;
}

.settings-switch {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
    padding: 8px 0;
    margin: 0;
    border-bottom-width: 1px;
    border-bottom-color: #F1F5F9;
}

.settings-toggle--last {
    border-bottom-width: 0;
    padding-bottom: 2px;
}

.settings-switch .unity-toggle__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 13px;
    color: #1E293B;
    white-space: normal;
    margin: 0 12px 0 0;
    padding: 0;
}

.settings-switch .unity-toggle__input {
    position: relative;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    width: 48px;
    min-width: 48px;
    max-width: 48px;
    height: 28px;
    min-height: 28px;
    max-height: 28px;
    flex-grow: 0;
    flex-shrink: 0;
    border-radius: 14px;
    background-color: #CBD5E1;
    border-width: 0;
    padding: 0;
    margin: 0;
    overflow: hidden;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.settings-switch:checked .unity-toggle__input {
    background-color: #0EA5E9;
}

.settings-switch .unity-toggle__checkmark {
    position: absolute;
    left: 3px;
    top: 3px;
    right: auto;
    bottom: auto;
    width: 22px;
    min-width: 22px;
    max-width: 22px;
    height: 22px;
    min-height: 22px;
    max-height: 22px;
    border-radius: 11px;
    background-image: none;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
    background-color: #FFFFFF;
    border-width: 1px;
    border-color: rgba(15, 23, 42, 0.08);
    margin: 0;
    padding: 0;
    translate: 0 0;
    transition-property: translate;
    transition-duration: 0.15s;
}

.settings-switch:checked .unity-toggle__checkmark {
    translate: 20px 0;
}

/* Telemetry Tiles & Diagnostics */
.telemetry-grid {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 10px;
}

.telemetry-tile {
    width: 23.5%;
    background-color: #F8FAFC;
    border-width: 1px;
    border-color: #E2E8F0;
    border-radius: 12px;
    padding: 8px 4px;
    align-items: center;
    overflow: hidden;
}

.telemetry-label {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 9px;
    letter-spacing: 0.5px;
    color: #64748B;
    margin: 0 0 2px 0;
    padding: 0;
}

.telemetry-value {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 12px;
    color: #0F172A;
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
    padding: 0;
}

.diagnostics-box {
    background-color: #F8FAFC;
    border-width: 1px;
    border-color: #E2E8F0;
    border-radius: 12px;
    padding: 10px 12px;
}

.diagnostics-text {
    font-size: 11px;
    color: #475569;
    white-space: normal;
    margin: 0;
    padding: 0;
}

/* ---------- Offline Map Editor & AR Authoring ---------- */
.idle-header-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.btn-header-add {
    height: 36px;
    padding: 0 11px;
    margin-right: 8px;
    border-width: 1px;
    border-color: #BAE6FD;
}

.btn-header-add-label {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 12px;
    color: #0369A1;
    margin: 0 0 0 5px;
    padding: 0;
}

.picker-header-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.btn-picker-manage {
    margin-right: 8px;
    border-width: 1px;
    border-color: #BAE6FD;
}

.authoring-actions-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
}

.authoring-btn-half {
    width: 48.5%;
    height: 44px;
    margin-left: 0;
}

.modal-custom-chip {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 10px;
    color: #047857;
    background-color: #D1FAE5;
    border-radius: 9px;
    padding: 2px 7px;
    margin-left: 6px;
}

.map-editor-feedback {
    background-color: #ECFDF5;
    border-width: 1px;
    border-color: #A7F3D0;
    border-radius: 12px;
    padding: 8px 12px;
    margin: 0 18px 8px 18px;
}

.map-editor-feedback--error {
    background-color: #FFF1F2;
    border-color: #FECDD3;
}

.map-editor-feedback-text {
    font-size: 12px;
    color: #047857;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.map-editor-feedback--error .map-editor-feedback-text {
    color: #BE123C;
}

.map-editor-item-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 8px;
}

.btn-row-icon {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background-color: #F1F5F9;
    border-width: 1px;
    border-color: #E2E8F0;
    justify-content: center;
    align-items: center;
    padding: 0;
    margin: 0 0 0 6px;
}

.btn-row-icon:hover {
    background-color: #E2E8F0;
}

.btn-row-icon--danger {
    background-color: #FFF1F2;
    border-color: #FECDD3;
}

.btn-row-icon--danger:hover {
    background-color: #FFE4E6;
}

.btn-row-icon:disabled {
    opacity: 0.4;
}

.map-editor-utility-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
}

.map-editor-utility-btn {
    width: 48.5%;
    height: 40px;
    border-radius: 12px;
    font-size: 13px;
    margin-left: 0;
}

.btn-utility-label {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 13px;
    color: #1E293B;
    margin: 0 0 0 6px;
    padding: 0;
}

.poi-form-body {
    padding: 4px 18px 16px 18px;
    flex-direction: column;
}

.poi-form-connection-box {
    background-color: #F0F9FF;
    border-width: 1px;
    border-color: #BAE6FD;
    border-radius: 12px;
    padding: 9px 12px;
    margin-bottom: 12px;
}

.poi-form-connection-text {
    font-size: 12px;
    color: #0369A1;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.poi-form-error {
    font-size: 12px;
    color: #BE123C;
    background-color: #FFF1F2;
    border-width: 1px;
    border-color: #FECDD3;
    border-radius: 10px;
    padding: 7px 10px;
    margin-bottom: 10px;
    white-space: normal;
}

.poi-form-field-label {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 12px;
    color: #334155;
    margin: 0 0 6px 2px;
    padding: 0;
}

.poi-form-input-box {
    margin: 0 0 14px 0;
    padding: 0 12px;
}

.poi-form-text-input {
    margin: 0;
}

.poi-form-category-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.poi-form-category-chip {
    margin: 0 7px 7px 0;
}

.poi-form-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
}

.poi-form-field-label--spaced {
    margin-top: 8px;
}

.poi-form-description-box {
    background-color: #FFFFFF;
    border-width: 1.5px;
    border-color: #E2E8F0;
    border-radius: 15px;
    min-height: 84px;
    padding: 9px 12px;
    transition-property: border-color;
    transition-duration: 0.14s;
}

.poi-form-description-input {
    flex-grow: 1;
    margin: 0;
}

.poi-form-description-input .unity-base-text-field__input {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
    font-size: 13px;
    color: #0F172A;
    white-space: normal;
    -unity-text-align: upper-left;
}

.poi-description-preview {
    font-size: 11px;
    color: #475569;
    margin: 3px 0 0 0;
    padding: 0;
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.robot-speech-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.robot-speech-bubble {
    position: absolute;
    min-width: 176px;
    max-width: 272px;
    background-color: rgba(255, 255, 255, 0.96);
    border-width: 1.5px;
    border-color: #6EE7B7;
    border-radius: 18px;
    padding: 10px 13px 11px 13px;
    flex-direction: column;
}

.robot-speech-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.robot-speech-badge {
    width: 22px;
    height: 22px;
    border-radius: 7px;
    background-color: #D1FAE5;
    justify-content: center;
    align-items: center;
    margin-right: 7px;
    flex-shrink: 0;
}

.robot-speech-title {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 10px;
    letter-spacing: 0.5px;
    color: #047857;
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.robot-speak-btn {
    width: 26px;
    height: 26px;
    border-radius: 9px;
    background-color: #ECFDF5;
    border-width: 1px;
    border-color: #A7F3D0;
    justify-content: center;
    align-items: center;
    padding: 0;
    margin: 0 0 0 8px;
    flex-shrink: 0;
}

.robot-speak-btn:hover {
    background-color: #D1FAE5;
}

.robot-speak-btn--speaking {
    background-color: #A7F3D0;
    border-color: #10B981;
}

.robot-speech-body {
    font-size: 13px;
    color: #0F172A;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.robot-speech-tail {
    position: absolute;
    bottom: -7px;
    left: 50%;
    width: 12px;
    height: 12px;
    background-color: rgba(255, 255, 255, 0.96);
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-color: #6EE7B7;
    rotate: 45deg;
}

.tts-api-key-box {
    margin: 0 0 6px 0;
    padding: 0 12px;
}

.tts-api-hint {
    font-size: 11px;
    color: #64748B;
    white-space: normal;
    margin: 0 0 10px 2px;
    padding: 0;
}

.tts-status-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: #F8FAFC;
    border-width: 1px;
    border-color: #E2E8F0;
    border-radius: 12px;
    padding: 7px 10px;
}

.tts-status-label {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 11px;
    color: #334155;
    white-space: normal;
    margin: 0 8px 0 0;
    padding: 0;
}

.tts-test-btn {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 0;
}

.btn-tts-test-label {
    -unity-font-definition: resource("UI/Fonts/Inter-SemiBold SDF");
    font-size: 12px;
    color: #0369A1;
    margin: 0 0 0 5px;
    padding: 0;
}
